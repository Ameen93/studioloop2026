{
  "name": "@sl/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "StudioLoop frontend monorepo",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "generate:api": "pnpm --filter @sl/api-client generate",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:reset-db": "./scripts/reset-test-db.sh",
    "build:consumer:dev": "pnpm --filter @sl/consumer-mobile build:dev",
    "build:consumer:preview": "pnpm --filter @sl/consumer-mobile build:preview",
    "build:consumer:prod": "pnpm --filter @sl/consumer-mobile build:prod",
    "build:gym:dev": "pnpm --filter @sl/gym-mobile build:dev",
    "build:gym:preview": "pnpm --filter @sl/gym-mobile build:preview",
    "build:gym:prod": "pnpm --filter @sl/gym-mobile build:prod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.9",
    "esbuild": "^0.27.2",
    "turbo": "^2.7.5",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
