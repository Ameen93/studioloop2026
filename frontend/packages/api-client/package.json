{
  "name": "@sl/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generated": {
      "types": "./src/generated/index.ts",
      "default": "./src/generated/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src --ignore-pattern 'src/generated/**'",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests configured for @sl/api-client - generated code\"",
    "export-openapi": "bash ../../scripts/export-openapi.sh",
    "generate": "pnpm run export-openapi && openapi-ts"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.9.0",
    "@tanstack/react-query": "^5.80.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hey-api/openapi-ts": "^0.66.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
