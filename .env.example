# StudioLoop — environment configuration
#
# Copy this file to `.env` IN THE REPOSITORY ROOT (not in backend/).
# The backend reads `../.env` relative to the backend/ directory — see
# backend/app/core/config.py (`env_file="../.env"`).
#
#   cp .env.example .env
#
# Only the variables marked REQUIRED have no default. Everything else has a
# working default for local development.

# ---------------------------------------------------------------------------
# Core (REQUIRED)
# ---------------------------------------------------------------------------

# REQUIRED — no default. Used as the app name and as the default email sender name.
PROJECT_NAME=StudioLoop

# REQUIRED — no default. The bootstrap superuser created by the prestart script.
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# local | staging | production
# `local` relaxes several checks: "changethis" secrets only warn instead of
# raising, local web-app CORS origins are added automatically, and the
# local-only debug endpoints are enabled.
ENVIRONMENT=local

# Demo seeding. backend/scripts/seed.py creates accounts with publicly known
# passwords, so backend/scripts/prestart.sh only runs it when ENVIRONMENT=local.
# Setting this outside local does not enable seeding — it aborts the start, so a
# misconfiguration fails instead of quietly provisioning those accounts.
SEED_DEMO_DATA=false

# Signing key for JWTs. A random key is generated per process if unset, which
# means tokens are invalidated on every restart — set it explicitly.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# These defaults match docker-compose.local.yml, so they work as-is with
# `docker compose -f docker-compose.local.yml up -d`.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app

# Alternative to the POSTGRES_* vars above: a single connection URL.
# If set, it takes precedence. `postgresql://` is rewritten to
# `postgresql+psycopg://` automatically.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
FRONTEND_HOST=http://localhost:5173
# Comma-separated, or a JSON array. FRONTEND_HOST is always included.
# In ENVIRONMENT=local, localhost:5173-5175 are added automatically.
BACKEND_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Email (optional — email is disabled unless SMTP_HOST and EMAILS_FROM_EMAIL
# are both set. Password reset and account emails silently no-op without it.)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL=
# Defaults to PROJECT_NAME when empty.
EMAILS_FROM_NAME=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# ozow | payfast | stitch
# NOTE: `ozow` and `payfast` are NOT real integrations — they are in-repo fakes
# used for local development and tests (see backend/app/services/payments/
# providers.py). Only `stitch` makes real outbound calls. The config validator
# forces `stitch` when ENVIRONMENT=production, and rejects any value that is not
# one of the three names above.
#
# This value alone decides which verifier checks an inbound webhook. The URL a
# webhook arrives on cannot select a different one.
PAYMENT_PROVIDER=ozow

# `payfast` holds no signing secret, so it cannot authenticate a webhook at all
# and refuses every one of them. Set this to true to drive it anyway from a
# local machine; the config validator rejects it unless ENVIRONMENT=local.
PAYMENT_ALLOW_UNVERIFIED_STUB_WEBHOOKS=false

PAYMENT_RETRY_INTERVAL_DAYS=1,3,7
PAYMENT_PLATFORM_FEE_PERCENT=15.0
PAYMENT_RECEIPT_VAT_PERCENT=15.0

# Stitch (https://stitch.money) — only needed if PAYMENT_PROVIDER=stitch.
# Required (non-empty) whenever ENVIRONMENT is not `local`: STITCH_WEBHOOK_SECRET.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
STITCH_API_URL=https://api.stitch.money/graphql
STITCH_TOKEN_URL=https://secure.stitch.money/connect/token
STITCH_REDIRECT_BASE_URL=https://secure.stitch.money/connect/payment-request

# ---------------------------------------------------------------------------
# OAuth (optional — social login endpoints return errors without these)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/consumer/google/callback
GOOGLE_STAFF_REDIRECT_URI=http://localhost:8000/api/v1/auth/staff/google/callback

# APPLE_PRIVATE_KEY is the contents of the .p8 key file, newlines included.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/consumer/apple/callback
APPLE_STAFF_REDIRECT_URI=http://localhost:8000/api/v1/auth/staff/apple/callback

# Comma-separated allow-list of post-OAuth redirect targets.
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5175/auth/oauth-callback,http://localhost:5174/auth/oauth-callback,studioloop-consumer://oauth-callback,studioloop-gym://oauth-callback

# ---------------------------------------------------------------------------
# Tokens / misc
# ---------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# Error tracking. Ignored when ENVIRONMENT=local.
SENTRY_DSN=
